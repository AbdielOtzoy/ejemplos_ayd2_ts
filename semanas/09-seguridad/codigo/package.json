    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.0",
    "@nestjs/cli": "^12.0.6",
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  }
